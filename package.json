{
  "name": "cognify",
  "version": "0.1.0",
  "description": "Cognify — AI knowledge management lokal & offline",
  "type": "module",
  "scripts": {
    "predev": "node scripts/excalidraw-assets.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/excalidraw-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "sidecar:setup": "uv --directory sidecar sync",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "notch:build": "node scripts/build-notch.mjs",
    "notch:app": "zsh scripts/build-notch-app.sh",
    "notch:release": "zsh scripts/release-notch.sh",
    "notch:publish-source": "zsh scripts/publish-notch-source.sh",
    "release:mac": "zsh scripts/release-mac.sh",
    "sidecar:dev": "COGNIFY_TOKEN=cognify-dev-token uv --directory sidecar run python -m cognify_sidecar --port 8765 --data-dir .devdata",
    "sidecar:test": "uv --directory sidecar run pytest -q",
    "engines": "node scripts/fetch-engines.mjs",
    "test": "vitest run",
    "tauri:build": "node scripts/fetch-engines.mjs && tauri build --config src-tauri/tauri.sidecar.conf.json"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@lucide/svelte": "^1.58.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "citeproc": "^2.4.63",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "jsqr": "^1.4.0",
    "marked": "^18.0.14",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/d3-force": "^3.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
