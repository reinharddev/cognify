<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (build bertanda tangan): izinkan mengirim Apple Events ke Notes. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened runtime: izinkan mikrofon untuk catatan suara. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Notch: Cermin kamera & agenda Kalender (program cognify-notch memakai izin Cognify). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
