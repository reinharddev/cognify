{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cognify",
  "mainBinaryName": "Cognify",
  "version": "0.1.0",
  "identifier": "com.reinhard.cognify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Cognify",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:1420 ws://localhost:1420",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 165,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 205
        }
      }
    },
    "resources": {
      "../extension": "extension"
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Indonesian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
